{% extends 'account/base.html.twig' %}

{# Section page: "Change password" under the Security group.

    The browser title shows just the section name (the page h1 stays
    "Profile & Settings" on every settings page so we don't repeat it here).
#}

{% block settings_title %}{{ 'app.account.change_password.title'|trans }}{% endblock %}

{% block settings_content %}
    {# Heading row: small breadcrumb on the left (parent = 'Settings' as a
       link back to the hub, current = 'Change password' in black) and the
       minimalist back link on the right. Mirrors the hub's h2 + right-side
       hint rhythm — left = heading, right = action. The breadcrumb is
       intentionally NOT promoted to a heading size; it stays at the
       original small text size. #}
    <div class="mb-6 flex items-center justify-between gap-4">
        <nav aria-label="Breadcrumb" class="text-sm">
            <a href="{{ path('account_profile_settings') }}"
               class="text-stone-500 hover:text-stone-900">{{ 'app.account.index.settings'|trans }}</a>
            <span aria-hidden="true" class="mx-2 text-stone-400">&rsaquo;</span>
            <span class="font-medium text-stone-900">{{ 'app.account.change_password.title'|trans }}</span>
        </nav>

        <div class="shrink-0">
            {% include 'account/_back_link.html.twig' %}
        </div>
    </div>

    {# Section card. The card renders no <h2> because the breadcrumb
       already names the section; we pass description only. #}
    {% embed 'account/_section.html.twig' with {
        description: 'app.account.change_password.description'|trans,
    } %}
        {% block section_content %}
            {{ form_start(form, {attr: {class: 'max-w-md'}}) }}
                {{ form_row(form.currentPassword) }}
                {{ form_row(form.newPassword) }}
                <div class="mt-6">
                    <button type="submit"
                            class="inline-flex items-center rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 shadow-sm hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                        {{ 'app.account.change_password.submit'|trans }}
                    </button>
                </div>
            {{ form_end(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
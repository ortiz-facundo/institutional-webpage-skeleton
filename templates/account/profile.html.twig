{% extends 'admin/base.html.twig' %}

{% block title %}My profile — Nova Argentum{% endblock %}

{% block admin_body %}
    {% set user = app.user %}

    <div class="max-w-2xl">
        <div class="rounded-lg border border-stone-200 bg-white p-8 shadow-sm">
            <div class="flex items-start gap-6">
                {% include '_avatar.html.twig' with {user: user, size: 'lg'} only %}

                <div class="min-w-0 flex-1">
                    <h1 class="font-serif text-2xl text-stone-900">
                        {{ user.name ?: user.email }}
                    </h1>
                    <p class="mt-1 text-sm text-stone-500">{{ user.email }}</p>

                    <dl class="mt-6 grid grid-cols-[7rem_1fr] gap-y-3 text-sm">
                        <dt class="text-stone-500">Roles</dt>
                        <dd class="flex flex-wrap gap-1">
                            {% for role in user.roleEntities %}
                                <span class="inline-block rounded-md bg-stone-100 px-2 py-0.5 text-xs font-medium text-stone-700">
                                    {{ role.name }}
                                </span>
                            {% else %}
                                <span class="text-stone-400 italic">No roles assigned</span>
                            {% endfor %}
                        </dd>

                        <dt class="text-stone-500">Account state</dt>
                        <dd>
                            {% if user.state == 'USER_STATE_ACTIVE' %}
                                <span class="inline-flex items-center gap-1 rounded-md bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">
                                    Active
                                </span>
                            {% elseif user.state == 'USER_STATE_PENDING' %}
                                <span class="inline-flex items-center gap-1 rounded-md bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
                                    Pending confirmation
                                </span>
                            {% elseif user.state == 'USER_STATE_DISABLED' %}
                                <span class="inline-flex items-center gap-1 rounded-md bg-rose-50 px-2 py-0.5 text-xs font-medium text-rose-700">
                                    Disabled
                                </span>
                            {% else %}
                                <span class="text-xs text-stone-500">{{ user.state }}</span>
                            {% endif %}
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        {% if is_granted(constant('App\\Security\\Permission::PERMISSION_VIEW_BACKOFFICE')) %}
            <a href="{{ path('admin_dashboard') }}"
               class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-amber-700 hover:text-amber-800">
                <span aria-hidden="true">&larr;</span>
                <span>Back to admin</span>
            </a>
        {% endif %}
    </div>
{% endblock %}
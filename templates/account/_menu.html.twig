{#
    Grouped settings menu — the data file + the renderer entry point.

    Adding a new settings item:
      1. Append a row to the matching group's `items` array below, with
         `enabled: true` once the controller + template exist.
      2. Until then, leave `enabled: false` so the row renders as a
         greyed-out "soon" hint rather than a broken link. The disabled
         branch never calls `path()` so non-existent routes are safe.

    Adding a new group:
      1. Append a new entry to the `groups` array.

    Item schema:
      label:   string           visible text
      route:   string           Symfony route name (passed to path() when enabled)
      enabled: bool = true      false → render as greyed-out "soon" placeholder

    Group schema:
      label:   string           visible group heading (uppercase, small)
#}
{% set current_route = current_route|default(app.request.attributes.get('_route')) %}
{% set groups = [
    {
        label: 'app.account.menu.group.security'|trans,
        items: [
            {label: 'app.account.menu.item.change_password'|trans, route: 'account_change_password', enabled: true},
            {label: 'app.account.menu.item.active_sessions'|trans, route: 'account_active_sessions', enabled: false},
            {label: 'app.account.menu.item.two_factor'|trans,     route: 'account_two_factor',       enabled: false},
        ],
    },
    {
        label: 'app.account.menu.group.preferences'|trans,
        items: [
            {label: 'app.account.menu.item.locale'|trans,         route: 'account_profile_settings_locale', enabled: true},
            {label: 'app.account.menu.item.notifications'|trans,  route: 'account_preferences_notifications', enabled: true},
        ],
    },
    {
        label: 'app.account.menu.group.danger_zone'|trans,
        items: [
            {label: 'app.account.menu.item.disable_account'|trans, route: 'account_disable', enabled: false},
        ],
    },
] %}

{% import 'account/_menu_group.html.twig' as menu %}

<div class="rounded-lg border border-stone-200 bg-white px-3 py-4 shadow-sm">
    <div class="space-y-6">
        {% for group in groups %}
            {{ menu.menu_group(group, current_route) }}
        {% endfor %}
    </div>
</div>

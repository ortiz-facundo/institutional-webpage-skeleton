{#
    Profile header for /account/profile-settings.

    Reusable card showing the authenticated user's avatar + name + email
    + account state + roles. Used at the top of the unified hub AND at
    the top of every section page (so the user sees their identity on
    every page of the configuration experience).

    Contract:
      @var user App\Entity\Administration\User

    Visual: same `rounded-lg border border-stone-200 bg-white p-8 shadow-sm`
    recipe as the rest of the backoffice cards. Avatar uses the shared
    `_avatar.html.twig` partial at size 'lg' (h-24 w-24).
#}
{% set user = user|default(app.user) %}

<div class="rounded-lg border border-stone-200 bg-white p-8 shadow-sm">
    <div class="flex items-start gap-6">
        {% include '_avatar.html.twig' with {user: user, size: 'lg'} only %}

        <div class="min-w-0 flex-1">
            <h1 class="font-serif text-2xl text-stone-900">
                {{ user.name ?: user.email }}
            </h1>
            <p class="mt-1 text-sm text-stone-500">{{ user.email }}</p>

            <dl class="mt-6 grid grid-cols-[7rem_1fr] gap-y-3 text-sm">
                <dt class="text-stone-500">{{ 'app.account.profile.header.roles'|trans }}</dt>
                <dd class="flex flex-wrap gap-1">
                    {% for role in user.roleEntities %}
                        <span class="inline-block rounded-md bg-stone-100 px-2 py-0.5 text-xs font-medium text-stone-700">
                            {{ role.name }}
                        </span>
                    {% else %}
                        <span class="text-stone-400 italic">{{ 'app.account.profile.header.no_roles'|trans }}</span>
                    {% endfor %}
                </dd>

                <dt class="text-stone-500">{{ 'app.account.profile.header.state'|trans }}</dt>
                <dd>{% include '_state_pill.html.twig' with {state: user.state} only %}</dd>
            </dl>
        </div>
    </div>
</div>
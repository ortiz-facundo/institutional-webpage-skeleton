{#
    Profile header for /account/profile-settings.

    Reusable card showing the authenticated user's avatar + name + email
    + account state + roles. Used at the top of the unified hub AND at
    the top of every section page (so the user sees their identity on
    every page of the configuration experience).

    Contract:
      @var user           App\Entity\Administration\User
      @var avatarEditForm FormView|null  Only passed by ProfileSettingsController
                           (the hub, /account/profile-settings). When present,
                           the avatar gets a hover pencil/cross overlay wired
                           to assets/js/avatar-editor.js — pick a photo, crop
                           it square, and the crop dialog's Save auto-submits
                           this form (POST /account/profile-settings/edit-profile,
                           handled by EditProfileController). The cross (only
                           shown once a photo exists — Vich only adds the
                           `delete` sub-field then) opens a confirm dialog that
                           does the same. Every other settings page renders
                           this partial without `avatarEditForm`, so the
                           overlay simply doesn't appear there.

    Visual: same `rounded-lg border border-stone-200 bg-white p-8 shadow-sm`
    recipe as the rest of the backoffice cards. Avatar uses the shared
    `_avatar.html.twig` partial at size 'lg' (h-24 w-24).
#}
{% set user = user|default(app.user) %}
{% set editableAvatar = avatarEditForm is defined and avatarEditForm %}

<div class="rounded-lg border border-stone-200 bg-white p-8 shadow-sm">
    <div class="flex items-start gap-6">
        {% if editableAvatar %}
            <div class="group relative shrink-0" data-controller-root="avatar-editor" data-target-size="512">
                {{ form_start(avatarEditForm, {
                    action: path('account_profile_settings_edit_profile'),
                    attr: {'data-avatar-editor-form': ''},
                }) }}
                    {% if avatarEditForm.vars.errors|length > 0 %}
                        <div class="mb-2 max-w-[6rem] text-xs text-rose-600">
                            {{ form_errors(avatarEditForm) }}
                        </div>
                    {% endif %}

                    {% include '_avatar.html.twig' with {user: user, size: 'lg'} only %}

                    <div class="absolute -bottom-1 -right-1 flex gap-1 opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
                        <button type="button" data-avatar-edit-trigger
                                class="flex h-7 w-7 items-center justify-center rounded-full bg-stone-900 text-stone-50 shadow-sm hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2"
                                aria-label="{{ 'app.account.edit_profile.photo.edit'|trans }}">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                            </svg>
                        </button>
                        {% if avatarEditForm.avatarFile.delete is defined %}
                            <button type="button" data-avatar-delete-trigger
                                    class="flex h-7 w-7 items-center justify-center rounded-full bg-white text-rose-600 shadow-sm ring-1 ring-stone-200 hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2"
                                    aria-label="{{ 'app.account.edit_profile.photo.remove'|trans }}">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                     stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                </svg>
                            </button>
                        {% endif %}
                    </div>

                    {# `hidden` alone loses to the form theme's own `block`/layout
                       utility classes (both specificity 0,1,0 — cascade order
                       decides, and Tailwind's isn't guaranteed to put `.hidden`
                       after `.block`), so force it with the `!` important
                       variant rather than relying on the boolean attribute. #}
                    {{ form_widget(avatarEditForm.avatarFile.file, {
                        attr: {hidden: true, class: '!hidden', accept: 'image/*', 'data-avatar-file-input': ''},
                    }) }}
                    {% if avatarEditForm.avatarFile.delete is defined %}
                        {{ form_widget(avatarEditForm.avatarFile.delete, {
                            attr: {hidden: true, class: '!hidden', 'data-avatar-delete-checkbox': ''},
                        }) }}
                    {% endif %}

                    <dialog data-avatar-crop-dialog data-app-dialog
                            class="rounded-xl border border-stone-200 bg-white p-0 shadow-xl"
                            aria-labelledby="avatar-crop-title">
                        <div class="w-[min(90vw,28rem)] p-5">
                            <h2 id="avatar-crop-title" class="font-serif text-lg text-stone-900">
                                {{ 'app.account.edit_profile.crop.title'|trans }}
                            </h2>
                            <p class="mt-1 text-sm text-stone-500">
                                {{ 'app.account.edit_profile.crop.description'|trans }}
                            </p>

                            <div class="mt-4 h-80 overflow-hidden rounded-lg bg-stone-100">
                                <img data-crop-target alt="" class="block max-w-full">
                            </div>

                            <div class="mt-4">
                                <label class="text-xs font-medium text-stone-500" for="avatar-crop-zoom">
                                    {{ 'app.account.edit_profile.crop.zoom'|trans }}
                                </label>
                                <input id="avatar-crop-zoom" data-crop-zoom type="range"
                                       min="-1" max="1" step="0.01" value="0"
                                       class="mt-1 w-full accent-stone-900">
                            </div>

                            <div class="mt-6 flex justify-end gap-2">
                                <button type="button" data-crop-cancel
                                        class="inline-flex items-center rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                                    {{ 'app.account.edit_profile.crop.cancel'|trans }}
                                </button>
                                <button type="button" data-crop-save
                                        class="inline-flex items-center rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 shadow-sm hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                                    {{ 'app.account.edit_profile.crop.save'|trans }}
                                </button>
                            </div>
                        </div>
                    </dialog>

                    {% if avatarEditForm.avatarFile.delete is defined %}
                        <dialog data-avatar-delete-dialog data-app-dialog
                                class="rounded-xl border border-stone-200 bg-white p-0 shadow-xl"
                                aria-labelledby="avatar-delete-title">
                            <div class="w-[min(90vw,24rem)] p-5">
                                <h2 id="avatar-delete-title" class="font-serif text-lg text-stone-900">
                                    {{ 'app.account.edit_profile.photo.remove_confirm.title'|trans }}
                                </h2>
                                <p class="mt-1 text-sm text-stone-500">
                                    {{ 'app.account.edit_profile.photo.remove_confirm.description'|trans }}
                                </p>
                                <div class="mt-6 flex justify-end gap-2">
                                    <button type="button" data-avatar-delete-cancel
                                            class="inline-flex items-center rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                                        {{ 'app.account.edit_profile.crop.cancel'|trans }}
                                    </button>
                                    <button type="button" data-avatar-delete-confirm
                                            class="inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                                        {{ 'app.account.edit_profile.photo.remove_confirm.confirm'|trans }}
                                    </button>
                                </div>
                            </div>
                        </dialog>
                    {% endif %}
                {# render_rest: false — the file/delete sub-fields are already
                   hand-rendered above (hidden, JS-driven); without this,
                   form_end's implicit form_rest() would render `avatarFile`
                   itself a second time via Vich's own (visible) default
                   widget block, since only its children were marked rendered.
                   That skips the CSRF `_token` field too though (also only
                   ever rendered via form_rest), so it needs rendering by hand. #}
                {{ form_widget(avatarEditForm._token) }}
                {{ form_end(avatarEditForm, {render_rest: false}) }}

                {% if avatarEditForm.avatarFile.vars.errors|length > 0 %}
                    <div class="mt-2 max-w-[6rem] text-xs text-rose-600">
                        {{ form_errors(avatarEditForm.avatarFile) }}
                    </div>
                {% endif %}
            </div>
        {% else %}
            {% include '_avatar.html.twig' with {user: user, size: 'lg'} only %}
        {% endif %}

        <div class="min-w-0 flex-1">
            <h1 class="font-serif text-2xl text-stone-900">
                {{ user.name ?: user.email }}
            </h1>
            <p class="mt-1 text-sm text-stone-500">{{ user.email }}</p>

            <dl class="mt-6 grid grid-cols-[7rem_1fr] gap-y-3 text-sm">
                <dt class="text-stone-500">{{ 'app.account.profile.header.roles'|trans }}</dt>
                <dd class="flex flex-wrap gap-1">
                    {% for role in user.roleEntities %}
                        <span class="inline-block rounded-md bg-stone-100 px-2 py-0.5 text-xs font-medium text-stone-700">
                            {{ role.name }}
                        </span>
                    {% else %}
                        <span class="text-stone-400 italic">{{ 'app.account.profile.header.no_roles'|trans }}</span>
                    {% endfor %}
                </dd>

                <dt class="text-stone-500">{{ 'app.account.profile.header.state'|trans }}</dt>
                <dd>{% include '_state_pill.html.twig' with {state: user.state} only %}</dd>
            </dl>
        </div>
    </div>
</div>
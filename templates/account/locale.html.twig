{% extends 'account/base.html.twig' %}

{# Section page: "Language" under the Preferences group. Lets the signed-in
   user pick the UI language (en / es). Anonymous traffic always lands on
   Spanish — there is no anonymous switcher, by design. #}

{% block settings_title %}{{ 'app.account.locale.title'|trans }}{% endblock %}

{% block settings_content %}
    <div class="mb-6 flex items-center justify-between gap-4">
        <nav aria-label="Breadcrumb" class="text-sm">
            <a href="{{ path('account_profile_settings') }}"
               class="text-stone-500 hover:text-stone-900">{{ 'app.account.index.settings'|trans }}</a>
            <span aria-hidden="true" class="mx-2 text-stone-400">&rsaquo;</span>
            <span class="font-medium text-stone-900">{{ 'app.account.locale.title'|trans }}</span>
        </nav>

        <div class="shrink-0">
            {% include 'account/_back_link.html.twig' %}
        </div>
    </div>

    {% embed 'account/_section.html.twig' with {
        description: 'app.account.locale.description'|trans,
    } %}
        {% block section_content %}
            {{ form_start(form, {attr: {class: 'max-w-md'}}) }}
                {{ form_row(form.locale) }}
                <div class="mt-6">
                    <button type="submit"
                            class="inline-flex items-center rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 shadow-sm hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                        {{ 'app.account.locale.save'|trans }}
                    </button>
                </div>
            {{ form_end(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{#
    Tailwind form theme. `{% use %}`s the default `form_div_layout.html.twig`
    so every block is defined; we only restyle the ones we want to change,
    and `{{ parent() }}` falls through to the default markup.

    Blocks overridden:
      - form_label
      - form_errors
      - form_row
      - form_widget_simple   (covers text/email/password/url/tel/etc.)
      - textarea_widget
      - choice_widget_expanded
      - choice_widget_collapsed  (renders via shared/custom_select.html.twig
                                   instead of a native <select> — every
                                   ChoiceType/EntityType field in the app
                                   that isn't `expanded: true` picks this
                                   up automatically, e.g. UserType::state,
                                   LocaleType::locale)
      - checkbox_widget
      - permission_picker_widget  (RoleType::permissions — grouped by module)
#}

{% use 'form_div_layout.html.twig' %}

{% block form_label %}
    {% set label_attr = label_attr|merge({
        class: (label_attr.class|default('') ~ ' block text-sm font-medium text-stone-700 mb-1')|trim
    }) %}
    {{ parent() }}
{% endblock %}

{% block form_label_content %}
    {%- if label is not same as(false) -%}
        {%- if not label -%}
            {%- if label_format is not empty -%}
                {% set label = label_format|replace({
                    '%name%': name,
                    '%id%': id,
                }) %}
            {%- else -%}
                {% set label = name|humanize %}
            {%- endif -%}
        {%- endif -%}
        {{ label|trans({}, translation_domain) }}
    {%- endif -%}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul {{ block('widget_attributes') }}>
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block form_row %}
    <div class="mb-4">
        {{ parent() }}
    </div>
{% endblock %}

{# Show validation feedback after the widget, rather than above it. #}
{% block form_row_render %}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr|default({})) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block form_widget_simple %}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ ' block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 placeholder-stone-400 shadow-sm focus:border-amber-600 focus:outline-none focus:ring-1 focus:ring-amber-600')|trim
    }) %}
    {{ parent() }}
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ ' block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 placeholder-stone-400 shadow-sm focus:border-amber-600 focus:outline-none focus:ring-1 focus:ring-amber-600')|trim
    }) %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_expanded %}
    <div {{ block('widget_container_attributes') }}>
        {% for child in form %}
            <label class="flex items-start gap-2 text-sm text-stone-800">
                <span class="flex items-center gap-2">
                    {{ form_widget(child, {attr: {class: 'h-4 w-4 rounded border-stone-300 text-amber-700 focus:ring-amber-600'}}) }}
                    {{ form_label(child, null, {translation_domain: choice_translation_domain}) }}
                </span>
                {# Per-choice error (rendered inline below the label).
                   This is what surfaces messages from Constraint
                   validators like OnlyAdminCanGrantAdminRole that use
                   atPath('[id]') on a specific checkbox. #}
                {{ form_errors(child) }}
            </label>
        {% endfor %}
    </div>
{% endblock %}

{# Every non-expanded ChoiceType/EntityType field (a native <select> in
   the default theme) renders through the shared CustomSelect component
   instead. `choices` here can be flat or one level of `optgroup`-style
   grouping (Symfony's ChoiceView tree) — both are flattened into the
   `{value, label}` list the component expects. The field's own label is
   still rendered by the surrounding `form_label` block (via `form_row`),
   so no `label` is passed here — that would double it up. #}
{% block choice_widget_collapsed %}
    {% set _options = [] %}
    {% for _group_label, _choice in choices %}
        {% if _choice is iterable %}
            {% for _opt in _choice %}
                {% set _attr = _opt.attr|default({}) %}
                {% set _options = _options|merge([{
                    value: _opt.value,
                    label: choice_translation_domain is same as(false) ? _opt.label : _opt.label|trans(_opt.labelTranslationParameters, choice_translation_domain),
                    title: _attr['data-option-title']|default(null),
                    icon: _attr['data-option-icon']|default(null),
                    dot_classes: _attr['data-dot-classes']|default(null),
                }]) %}
            {% endfor %}
        {% else %}
            {% set _attr = _choice.attr|default({}) %}
            {% set _options = _options|merge([{
                value: _choice.value,
                label: choice_translation_domain is same as(false) ? _choice.label : _choice.label|trans(_choice.labelTranslationParameters, choice_translation_domain),
                title: _attr['data-option-title']|default(null),
                icon: _attr['data-option-icon']|default(null),
                dot_classes: _attr['data-dot-classes']|default(null),
            }]) %}
        {% endif %}
    {% endfor %}
    {% set _native_attr = {} %}
    {% for _name, _value in attr|default({}) %}
        {% if _name not in ['class', 'data-select-filter'] %}
            {% set _native_attr = _native_attr|merge({(_name): _value}) %}
        {% endif %}
    {% endfor %}
    {% include 'shared/custom_select.html.twig' with {
        name: full_name,
        id: id,
        value: value,
        options: _options,
        placeholder: (placeholder is defined and placeholder is not none and placeholder != '') ? (translation_domain is same as(false) ? placeholder : placeholder|trans({}, translation_domain)) : '',
        multiple: multiple|default(false),
        invalid: valid is defined and not valid,
        filter: attr['data-select-filter']|default(false),
        native_attr: _native_attr,
    } only %}
{% endblock %}

{% block phone_input_widget %}
    <div {{ block('widget_container_attributes') }} data-phone-input class="space-y-2">
        <div class="flex flex-wrap items-start gap-2">
            <div class="w-32 shrink-0">{{ form_widget(form.country_code) }}</div>
            <div class="w-20 shrink-0">{{ form_widget(form.area_code, {attr: {'data-phone-area': '', 'aria-label': 'app.shared.phone.area'|trans}}) }}</div>
            <div class="min-w-36 flex-1">{{ form_widget(form.number, {attr: {'data-phone-number': '', 'aria-label': 'app.shared.phone.number'|trans}}) }}</div>
        </div>
        {% for child in [form.country_code, form.area_code, form.number] %}{{ form_errors(child) }}{% endfor %}
        <p class="text-xs text-stone-500">{{ 'app.shared.phone.preview'|trans }}: <span data-phone-preview class="font-mono text-stone-900">—</span></p>
    </div>
{% endblock %}

{% block tags_input_widget %}
    {% include 'shared/_tags_input.html.twig' with {
        id: id, full_name: full_name, value: value, placeholder: attr.placeholder|default(''),
        label: label, name: name, translation_domain: translation_domain
    } only %}
{% endblock %}

{% block tags_input_row %}
    <div class="mb-4">
        {% if label is not same as(false) %}<label for="{{ id }}-entry" class="mb-1 block text-sm font-medium text-stone-700">{{ label|default(name|humanize)|trans({}, translation_domain) }}</label>{% endif %}
        {{ form_widget(form) }}{{ form_help(form) }}{{ form_errors(form) }}
    </div>
{% endblock %}

{# Text-backed select for options populated later by a form controller. #}
{% block select_text_widget %}
    {% set placeholder = attr['data-placeholder']|default('') %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 shadow-sm focus:border-amber-600 focus:outline-none focus:ring-1 focus:ring-amber-600')|trim}) %}
    <select {{ block('widget_attributes') }}>
        <option value=""{{ value is empty ? ' selected' : '' }}>{{ placeholder }}</option>
        {% if value is not empty %}<option value="{{ value }}" selected>{{ value }}</option>{% endif %}
    </select>
{% endblock %}

{# Symfony's default color_widget already renders native type=color correctly;
   keep the native renderer but apply a matching focus/border treatment. #}
{% block color_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' h-10 w-16 cursor-pointer rounded-md border border-stone-300 bg-white p-1 focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-600')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block checkbox_widget %}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ ' h-4 w-4 rounded border-stone-300 text-amber-700 focus:ring-amber-600')|trim
    }) %}
    {{ parent() }}
{% endblock %}

{# ───────────────────────────────────────────────────────────────────
   permission_picker_widget
   Used only by App\Form\Administration\RoleType (via block_prefix).
   Renders the permission checkboxes grouped by module, with a per-row
   accessible information button that surfaces the permission description
   on hover (mouse) and focus (keyboard). New and edit-role pages share
   this widget through the same form type.

   Notes on the data shape:
     - `form.vars.choices` is grouped by module thanks to the form
       type's `group_by` callback. The iteration key inside each group
       is the choice list's array index (0, 1, 2, ...).
     - `form` (the field's children) are checkbox FormViews. Their
       `vars.value` is the entity ID (6, 7, 8, ...). The same entity
       is exposed as `choice.data` on the matching ChoiceView.
   So to render a row we look up each child's choice by entity ID.
   ─────────────────────────────────────────────────────────────────── #}
{% block permission_picker_widget %}
    <div {{ block('widget_container_attributes') }} class="mt-2 space-y-5">
        {% for group_label, group_view in form.vars.choices %}
            <fieldset class="rounded-md border border-stone-200 bg-stone-50/40 px-4 py-3">
                <legend class="px-1 text-xs font-semibold uppercase tracking-wider text-stone-500">
                    {{ ('permission_group.' ~ group_label ~ '.label')|trans }}
                </legend>
                <div class="mt-2 space-y-1.5">
                    {# The ChoiceType flattens grouped choices into flat child
                       FormViews, so for each choice we look up the matching
                       child by the entity ID shared with `choice.data.id`. #}
                    {% for _, choice in group_view.choices %}
                        {% set matching_child = null %}
                        {% for child in form %}
                            {% if matching_child is null and child.vars.value == choice.data.id %}
                                {% set matching_child = child %}
                            {% endif %}
                        {% endfor %}
                        {% if matching_child is not null %}
                            {% set child = matching_child %}
                            {% set child_id = child.vars.id %}
                            {% set tooltip_id = child_id ~ '_description' %}
                            {% set description = ('permission.' ~ choice.data.name ~ '.description')|trans %}
                            {% set localized_label = choice.label|trans(choice.labelTranslationParameters, choice_translation_domain) %}
                            <div class="perm-row relative flex items-start gap-2 py-1 pl-1 pr-1">
                                <span class="mt-[3px] shrink-0">
                                    {{ form_widget(child, {label: false}) }}
                                </span>
                                <label for="{{ child_id }}" class="cursor-pointer text-sm text-stone-800 select-none flex-1">
                                    {{ localized_label }}
                                </label>
                                <button type="button"
                                        aria-label="{{ 'app.administration.form.role.permission_info_aria'|trans({'%name%': localized_label}) }}"
                                        aria-describedby="{{ tooltip_id }}"
                                        class="peer/info ml-auto inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-stone-400 hover:text-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                         stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="h-4 w-4">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                                    </svg>
                                </button>
                                <span id="{{ tooltip_id }}"
                                      role="tooltip"
                                      class="perm-tooltip pointer-events-none absolute bottom-full right-0 z-20 mb-2 w-72 rounded-md bg-stone-900 px-3 py-2 text-xs leading-relaxed text-stone-50 opacity-0 shadow-lg transition-opacity duration-150 peer-hover/info:opacity-100 peer-focus/info:opacity-100">
                                    {{ description }}
                                </span>
                            </div>
                            {# Per-choice error (e.g. from the
                               OnlyAdminCanGrantAdminPermission constraint,
                               which uses atPath('[id]') on this specific
                               checkbox). #}
                            {{ form_errors(child) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </fieldset>
        {% endfor %}
    </div>
{% endblock %}

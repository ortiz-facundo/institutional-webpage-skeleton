{# Shared flash-message renderer for the backoffice and authentication shells. #}
{% set _tones = {
    success: 'border-l-emerald-400 bg-emerald-50 text-emerald-900',
    error:   'border-l-rose-400 bg-rose-50 text-rose-900',
    warning: 'border-l-yellow-500 bg-yellow-50 text-yellow-900',
    info:    'border-l-sky-300 bg-sky-50 text-sky-900',
} %}
{% set _badges = {
    success: 'bg-emerald-100 text-emerald-700',
    error:   'bg-rose-100 text-rose-700',
    warning: 'bg-yellow-100 text-yellow-800',
    info:    'bg-sky-100 text-sky-700',
} %}
{% set _icons = {
    success: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l2.25 2.25 4.5-4.5m5.25 2.25a9 9 0 11-18 0 9 9 0 0118 0z"/>',
    error:   '<path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 0 0118 0z"/>',
    warning: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>',
    info:    '<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>',
} %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="relative mb-4 flex items-start gap-3 rounded-md border border-stone-200 border-l-4 py-3 pl-4 pr-10 text-sm {{ _tones[label]|default(_tones.info) }}"
             data-controller="dismissible-flash">
            <span aria-hidden="true" class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full {{ _badges[label]|default(_badges.info) }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">{{ (_icons[label]|default(_icons.info))|raw }}</svg>
            </span>
            <p>{{ message }}</p>
            <button type="button"
                    data-action="dismiss-flash"
                    aria-label="{{ 'app.shared.dismiss'|trans }}"
                    class="absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-md text-current opacity-50 hover:bg-black/5 hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-current">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
                    <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>
                </svg>
            </button>
        </div>
    {% endfor %}
{% endfor %}

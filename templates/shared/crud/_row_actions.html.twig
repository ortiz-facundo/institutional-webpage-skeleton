{#
    Reusable per-row action cell. Renders an eye (view), pencil (edit),
    trash (delete), and (optionally) a "log in as" / resend button.
    Delete/impersonate/resend are CSRF-protected POST forms inside the
    cell; view/edit are GET links.

    Iconography: Heroicons 24/outline (MIT). Sized h-4 w-4 inside h-8 w-8
    square buttons. Stroke uses currentColor so the text-* utility sets
    the hue. Adding a fourth action? Add a block override in the
    consumer's index.html.twig that wraps this include.

    Visibility is decided by the action voter when an `*_attribute` is
    supplied. Legacy generic CRUD consumers can still use `*_permission`.

    Contract:
      @var entity                  object    the row's entity (needs getId())
      @var entity_label            string    e.g. 'User', 'Role'
      @var view_path               ?string   route name for view, optional
      @var view_permission         ?string   permission required to see it, or null
      @var edit_path                ?string   route name for edit, optional
      @var edit_permission          ?string   permission required to see it, or null
      @var delete_path              ?string   route name for delete, optional
      @var delete_token             ?string   CSRF token for this row (delete)
      @var delete_permission        ?string   permission required to see it, or null
      @var delete_attribute         ?string   voter attribute evaluated against entity
      @var impersonate_path         ?string   route name for impersonate, optional
      @var impersonate_token        ?string   CSRF token for this row (impersonate)
      @var impersonate_permission   ?string   permission required to see it, or null
      @var impersonate_attribute    ?string   voter attribute evaluated against entity
      @var resend_path              ?string   route name for resend, optional
      @var resend_token             ?string   CSRF token for this row (resend)
      @var resend_permission        ?string   permission required to see it, or null
      @var resend_attribute         ?string   voter attribute evaluated against entity
#}
<div class="inline-flex items-center gap-1">
    {% set _entity_lc = entity_label|default('item')|lower %}

    {% if view_path is defined and view_path and (view_permission|default(null) is null or is_granted(view_permission)) %}
        <a href="{{ path(view_path, {id: entity.id}) }}"
           title="{{ 'app.administration.crud.actions.view'|trans({'%entity%': _entity_lc}) }}"
           aria-label="{{ 'app.administration.crud.actions.view'|trans({'%entity%': _entity_lc}) }}"
           class="inline-flex h-8 w-8 items-center justify-center rounded-md text-sky-700 hover:bg-sky-50 focus:outline-none focus:ring-2 focus:ring-sky-600 focus:ring-offset-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
        </a>
    {% endif %}

    {% if edit_path is defined and edit_path and (edit_permission|default(null) is null or is_granted(edit_permission)) %}
        <a href="{{ path(edit_path, {id: entity.id}) }}"
           title="{{ 'app.administration.crud.actions.edit'|trans({'%entity%': _entity_lc}) }}"
           aria-label="{{ 'app.administration.crud.actions.edit'|trans({'%entity%': _entity_lc}) }}"
           class="inline-flex h-8 w-8 items-center justify-center rounded-md text-amber-700 hover:bg-amber-50 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
            </svg>
        </a>
    {% endif %}

    {# Impersonate / "log in as" — route existence plus the action voter. #}
    {% if impersonate_path is defined and impersonate_path and impersonate_token is defined
          and (impersonate_attribute|default(null) is not null
              ? is_granted(impersonate_attribute, entity)
              : (impersonate_permission|default(null) is null or is_granted(impersonate_permission))) %}
        <form method="post" action="{{ path(impersonate_path, {id: entity.id}) }}" class="inline"
              onsubmit="return confirm('{{ 'app.administration.crud.confirm.impersonate'|trans({'%entity%': _entity_lc}) }}')">
            <input type="hidden" name="_token" value="{{ impersonate_token }}">
            <button type="submit"
                    title="{{ 'app.administration.crud.actions.impersonate'|trans({'%entity%': _entity_lc}) }}"
                    aria-label="{{ 'app.administration.crud.actions.impersonate'|trans({'%entity%': _entity_lc}) }}"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-md text-violet-700 hover:bg-violet-50 focus:outline-none focus:ring-2 focus:ring-violet-600 focus:ring-offset-2">
                {# Heroicons 24/outline "users" — two overlapping users #}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                </svg>
            </button>
        </form>
    {% endif %}

    {# Resend confirmation — route existence plus the action voter. #}
    {% if resend_path is defined and resend_path and resend_token is defined
          and (resend_attribute|default(null) is not null
              ? is_granted(resend_attribute, entity)
              : (resend_permission|default(null) is null or is_granted(resend_permission))) %}
        <form method="post" action="{{ path(resend_path, {id: entity.id}) }}" class="inline"
              onsubmit="return confirm('{{ 'app.administration.crud.confirm.resend'|trans({'%entity%': _entity_lc}) }}')">
            <input type="hidden" name="_token" value="{{ resend_token }}">
            <button type="submit"
                    title="{{ 'app.administration.crud.actions.resend'|trans }}"
                    aria-label="{{ 'app.administration.crud.actions.resend'|trans }}"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-md text-amber-700 hover:bg-amber-50 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                {# Heroicons 24/outline "arrow-path" — resend / refresh #}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
            </button>
        </form>
    {% endif %}

    {% if delete_path is defined and delete_path and delete_token is defined
          and (delete_attribute|default(null) is not null
              ? is_granted(delete_attribute, entity)
              : (delete_permission|default(null) is null or is_granted(delete_permission))) %}
        <form method="post" action="{{ path(delete_path, {id: entity.id}) }}" class="inline"
              onsubmit="return confirm('{{ 'app.administration.crud.confirm.delete'|trans({'%entity%': _entity_lc}) }}')">
            <input type="hidden" name="_token" value="{{ delete_token }}">
            <button type="submit"
                    title="{{ 'app.administration.crud.actions.delete'|trans({'%entity%': _entity_lc}) }}"
                    aria-label="{{ 'app.administration.crud.actions.delete'|trans({'%entity%': _entity_lc}) }}"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-md text-rose-700 hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-600 focus:ring-offset-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
            </button>
        </form>
    {% endif %}
</div>

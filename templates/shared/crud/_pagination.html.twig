{#
    Pagination footer — count caption, page-number strip, per-page
    selector. Renders nothing when there's a single page with nothing
    to page through.

    Page-number links preserve every other query param via the
    `merge_query` Twig filter (`App\Twig\QueryStringExtension`). The
    per-page selector is a native `<select onchange="this.form.submit()">`
    inside a small GET form that re-emits the current query params as
    hidden inputs (a native form submit replaces the whole query string,
    so anything not re-emitted would be lost — e.g. an active `search`).

    Contract:
      @var page             int     1-based current page
      @var per_page         int     page size
      @var total             int     total rows matching the current filter
      @var total_pages       int     total page count
      @var current_url       string  the request URI (route + query)
      @var current_params    array   the request's query params, keyed by
                                      name (used for the per-page form's
                                      hidden inputs)
      @var per_page_options  list<int>  default [10, 25, 50]
#}
{% set _pages_in_window = 5 %}
{% set _window_start = max(1, page - 2) %}
{% set _window_end   = min(total_pages, _window_start + _pages_in_window - 1) %}
{% set _window_start = max(1, _window_end - _pages_in_window + 1) %}

{% if total > 0 %}
    <nav class="mt-4 flex flex-wrap items-center gap-3 text-sm"
         aria-label="{{ 'app.shared.pagination.aria'|trans }}">

        {% if total_pages > 1 %}
            <div class="flex min-w-0 flex-1 items-center justify-center gap-0.5">
                {% if page > 1 %}
                    <a href="{{ current_url|merge_query({'page': page - 1}) }}"
                       class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded text-stone-500 hover:bg-stone-100 hover:text-stone-900 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-1"
                       aria-label="{{ 'app.shared.pagination.previous_aria'|trans }}">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                        </svg>
                    </a>
                {% else %}
                    <span aria-disabled="true" class="inline-flex h-7 w-7 shrink-0 cursor-not-allowed items-center justify-center rounded text-stone-300">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                        </svg>
                    </span>
                {% endif %}

                {% if _window_start > 1 %}
                    <a href="{{ current_url|merge_query({'page': 1}) }}"
                       class="inline-flex h-7 min-w-7 shrink-0 items-center justify-center rounded px-1.5 text-stone-600 hover:bg-stone-100 hover:text-stone-900 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-1">1</a>
                    {% if _window_start > 2 %}
                        <span aria-hidden="true" class="shrink-0 px-1 text-stone-400">…</span>
                    {% endif %}
                {% endif %}

                {% for p in _window_start.._window_end %}
                    {% if p == page %}
                        <span aria-current="page"
                              class="inline-flex h-7 min-w-7 shrink-0 items-center justify-center rounded bg-stone-900 px-1.5 text-xs font-semibold text-stone-50">{{ p }}</span>
                    {% else %}
                        <a href="{{ current_url|merge_query({'page': p}) }}"
                           class="inline-flex h-7 min-w-7 shrink-0 items-center justify-center rounded px-1.5 text-stone-600 hover:bg-stone-100 hover:text-stone-900 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-1">{{ p }}</a>
                    {% endif %}
                {% endfor %}

                {% if _window_end < total_pages %}
                    {% if _window_end < total_pages - 1 %}
                        <span aria-hidden="true" class="shrink-0 px-1 text-stone-400">…</span>
                    {% endif %}
                    <a href="{{ current_url|merge_query({'page': total_pages}) }}"
                       class="inline-flex h-7 min-w-7 shrink-0 items-center justify-center rounded px-1.5 text-stone-600 hover:bg-stone-100 hover:text-stone-900 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-1">{{ total_pages }}</a>
                {% endif %}

                {% if page < total_pages %}
                    <a href="{{ current_url|merge_query({'page': page + 1}) }}"
                       class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded text-stone-500 hover:bg-stone-100 hover:text-stone-900 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-1"
                       aria-label="{{ 'app.shared.pagination.next_aria'|trans }}">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                        </svg>
                    </a>
                {% else %}
                    <span aria-disabled="true" class="inline-flex h-7 w-7 shrink-0 cursor-not-allowed items-center justify-center rounded text-stone-300">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                        </svg>
                    </span>
                {% endif %}
            </div>
        {% else %}
            <div class="min-w-0 flex-1"></div>
        {% endif %}

        <form method="get" class="shrink-0 flex items-center gap-1.5">
            {% for key, val in current_params|default({}) %}
                {% if key != 'page' and key != 'per_page' %}
                    <input type="hidden" name="{{ key }}" value="{{ val }}">
                {% endif %}
            {% endfor %}
            <label for="crud-list-per-page" class="text-xs font-semibold uppercase tracking-wider text-stone-500">
                {{ 'app.administration.crud.per_page_label'|trans }}
            </label>
            <select id="crud-list-per-page" name="per_page" onchange="this.form.submit()"
                    class="rounded-md border border-stone-300 bg-white py-1 pl-2 pr-6 text-sm text-stone-800 shadow-sm focus:border-amber-600 focus:outline-none focus:ring-1 focus:ring-amber-600">
                {% for option in per_page_options|default([10, 25, 50]) %}
                    <option value="{{ option }}" {{ option == per_page ? 'selected' : '' }}>{{ option }}</option>
                {% endfor %}
            </select>
        </form>
    </nav>
{% endif %}

{# CollectionType table. Provide form, collection, headers, row_template (a single
   <tr data-ctf-row> with a [data-action="ctf-remove-row"] button), and optionally
   id, empty_text, add_label, allow_add, field_alignments, theme.
   Row template receives entry, theme, is_template and index. For reordering,
   include buttons ctf-move-row-up/down and/or a .ctf-drag-handle. #}
{% set field = attribute(form, collection) %}
<div id="{{ id|default('collection-table-' ~ collection) }}" data-controller="collection-table-form" data-ctf-name="{{ field.vars.full_name }}" data-ctf-id="{{ field.vars.id }}" class="space-y-3">
    <div class="overflow-x-auto rounded-md border border-stone-200">
        <table class="min-w-full divide-y divide-stone-200">
            <thead class="bg-stone-50"><tr>
                {% for header in headers %}
                    {% set alignment = field_alignments[loop.index0]|default(loop.last ? 'right' : 'left') %}
                    <th scope="col" class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-stone-500 {{ alignment == 'right' ? 'text-right' : (alignment == 'center' ? 'text-center' : 'text-left') }}">{{ header }}</th>
                {% endfor %}
            </tr></thead>
            <tbody data-ctf-body class="divide-y divide-stone-200 bg-white">
                {% for entry in field %}
                    {% include row_template with {entry: entry, theme: theme|default('default'), is_template: false, index: loop.index0} only %}
                {% endfor %}
            </tbody>
        </table>
        <p data-ctf-empty class="px-4 py-6 text-center text-sm text-stone-500 {{ field|length ? 'hidden' : '' }}">{{ empty_text|default('') }}</p>
    </div>
    {% if field.vars.prototype is defined %}
        <template data-ctf-template>{% include row_template with {entry: field.vars.prototype, theme: theme|default('default'), is_template: true} only %}</template>
    {% endif %}
    {% if allow_add|default(true) and field.vars.prototype is defined %}
        <div class="flex justify-end"><button type="button" data-action="ctf-add-row" class="inline-flex items-center gap-1 rounded-md border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium text-stone-700 shadow-sm hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2"><span aria-hidden="true">+</span>{{ add_label|default('app.shared.crud.add_row')|trans }}</button></div>
    {% endif %}
</div>

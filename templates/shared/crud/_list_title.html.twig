{#
    Reusable list page header. Renders the title, the count line, and
    an optional "New" button. Extracted out of `_list.html.twig` so a
    search box / other chrome can sit between the title and the table.

    Contract:
      @var title             string       page title
      @var entity_label      string       e.g. 'User', 'Role'
      @var new_path          ?string
      @var new_label         string
      @var total             int|null     when set, the count line uses
                                           the paginated "Showing X–Y of
                                           Z" copy (when has_any_filter);
                                           otherwise the plain total-items
                                           copy. When unset, falls back to
                                           `items|length` (legacy callers
                                           that don't pass `total`).
      @var items              iterable<object>  used for the count line
                                                  fallback when `total` is
                                                  not passed
      @var has_any_filter     bool         default false
      @var page               int          default 1
      @var per_page           int          default total
      @var total_pages        int|null     when > 1 (multi-page result),
                                            the count line also uses the
                                            "Showing X–Y of Z" copy, even
                                            without an active filter
#}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-serif text-stone-900">{{ title }}</h1>
        <p class="text-sm text-stone-500 mt-1">
            {% set _total = total is defined and total is not null ? total : items|default([])|length %}
            {% if (has_any_filter|default(false) or total_pages|default(1) > 1) and _total > 0 %}
                {{ 'app.shared.pagination.showing'|trans({
                    '%from%': ((page|default(1) - 1) * per_page|default(_total)) + 1,
                    '%to%':   min(_total, page|default(1) * per_page|default(_total)),
                    '%total%': _total,
                }) }}
            {% else %}
                {{ 'app.administration.crud.total_items'|trans({'%count%': _total}) }}
            {% endif %}
        </p>
    </div>
    {% if new_path is defined and new_path %}
        <a href="{{ path(new_path) }}"
           class="inline-flex items-center gap-2 rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 shadow-sm hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
            <span aria-hidden="true">+</span>
            <span>{{ new_label|default('app.administration.crud.new'|trans) }}</span>
        </a>
    {% endif %}
</div>

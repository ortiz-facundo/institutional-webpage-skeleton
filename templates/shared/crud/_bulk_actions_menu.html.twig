{#
    Right-side bulk-actions disclosure — lives in the toolbar row as a
    sibling of the filter `<details>` (see `_list_toolbar.html.twig`,
    which only includes this partial when `bulk_actions` is non-empty).
    Same visual chrome as the filter disclosure (border + shadow +
    chevron rotation) so the two read as a matched pair.

    Two branches inside the disclosure, toggled by
    `assets/js/crud-bulk-actions.js` based on the row-checkbox count:
      · "Select rows first" hint — shown when 0 rows are checked.
      · Per-action menu items — shown when ≥1 rows are checked. One
        button per registered BulkActionInterface, carrying
        `data-crud-bulk-menu-item="{{ id }}"` so the JS opens the right
        modal on click.

    Contract:
      @var bulk_actions  list<App\Crud\BulkAction\BulkActionInterface>
                                  permission-gated by the controller;
                                  the partial just iterates
      @var entity_label  string  e.g. 'User' — used in the pluralised
                                  "N selected" copy
#}
{% set _selected_one   = 'app.administration.crud.bulk.menu.selected_one'|trans({'%entity%': entity_label|default('item')|lower}) %}
{% set _selected_other = 'app.administration.crud.bulk.menu.selected_other'|trans({'%count%': '%count%', '%entity%': entity_label|default('item')|lower}) %}
<details class="relative" data-crud-bulk-menu-details>
    <summary data-crud-bulk-menu-summary
             class="group inline-flex cursor-pointer list-none items-center gap-2 rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700 shadow-sm hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2
                    [&::-webkit-details-marker]:hidden [&::marker]:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="h-4 w-4">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
        </svg>
        <span>{{ 'app.administration.crud.bulk.menu.label'|trans }}</span>
        <span data-crud-bulk-menu-count
              class="hidden inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-amber-700 px-1.5 text-[0.6875rem] font-semibold text-white">0</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor" aria-hidden="true"
             class="h-4 w-4 transition-transform duration-150 group-open:rotate-180">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
    </summary>

    <div class="absolute right-0 top-full z-30 mt-2 w-72 max-w-[calc(100vw-2rem)] rounded-lg border border-stone-200 bg-white p-2 shadow-lg ring-1 ring-stone-900/5">

        <div data-crud-bulk-menu-empty class="px-3 py-2">
            <p class="text-sm font-medium text-stone-700">
                {{ 'app.administration.crud.bulk.menu.empty_title'|trans }}
            </p>
            <p class="mt-1 text-xs text-stone-500">
                {{ 'app.administration.crud.bulk.menu.empty_hint'|trans }}
            </p>
        </div>

        <ul data-crud-bulk-menu-list class="hidden space-y-1">
            <li class="px-3 pb-1 pt-2">
                <span data-crud-bulk-menu-summary-text
                      data-label-one="{{ _selected_one }}"
                      data-label-other="{{ _selected_other }}"
                      class="text-xs font-semibold uppercase tracking-[0.18em] text-stone-500">
                    {{ _selected_other|replace({'%count%': 0}) }}
                </span>
            </li>
            {% for action in bulk_actions %}
                {% set _modal_id = action.modalPartial is not empty
                    ? 'crud-bulk-' ~ action.id|replace({'_': '-'}) ~ '-modal'
                    : null %}
                <li>
                    <button type="button"
                            data-crud-bulk-menu-item="{{ action.id }}"
                            data-modal-id="{{ _modal_id }}"
                            data-modal-intent="{{ action.intent ?? '' }}"
                            class="group flex w-full items-center gap-2.5 rounded-md px-3 py-2 text-left text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                        {% if action.icon == 'users' %}
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="1.5" stroke="currentColor" aria-hidden="true"
                                 class="h-4 w-4 shrink-0 text-amber-700 group-hover:text-amber-800">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                            </svg>
                        {% elseif action.icon == 'user-minus' %}
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="1.5" stroke="currentColor" aria-hidden="true"
                                 class="h-4 w-4 shrink-0 text-rose-700 group-hover:text-rose-800">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M22 11h-4.5l1.5-1.5M22 11l-1.5 1.5M22 11v-3a2.25 2.25 0 0 0-2.25-2.25h-3M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Z" />
                            </svg>
                        {% elseif action.icon == 'trash' %}
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="1.5" stroke="currentColor" aria-hidden="true"
                                 class="h-4 w-4 shrink-0 text-rose-700 group-hover:text-rose-800">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                            </svg>
                        {% endif %}
                        <span class="min-w-0 flex-1 truncate">{{ action.label }}</span>
                    </button>
                </li>
            {% endfor %}
        </ul>
    </div>
</details>

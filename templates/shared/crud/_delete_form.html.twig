{#
    Reusable CSRF-protected POST form used to delete a row.
    Contract:
      @var path   string  e.g. 'administration_role_delete'
      @var id     int|string
      @var token  string
      @var label  string
#}
{% set form_id = 'delete-form-' ~ id %}
<form id="{{ form_id }}" method="post" action="{{ path(path, {id: id}) }}">
    <input type="hidden" name="_token" value="{{ token }}">
    <button type="button"
            data-confirm-form="{{ form_id }}"
            data-confirm-title="{{ 'app.administration.crud.confirm.title.delete_generic'|trans }}"
            data-confirm-message="{{ 'app.administration.crud.confirm.generic'|trans }}"
            class="text-sm font-medium text-rose-700 hover:text-rose-800">
        {{ label|default('app.administration.crud.delete'|trans) }}
    </button>
</form>

{#
    Reusable list partial — TABLE ONLY. The title/count/"New" button
    chrome lives in `_list_title.html.twig` (included separately by the
    consumer) so a search box or other chrome can sit between the two.

    Contract:
      @var items             iterable<object>
      @var columns           list<{
          label:         string,
          path:          string,
          class?:        string,
          sortable?:     bool     opt-in: routes the header through
                                  `_list_header.html.twig` instead of a
                                  plain `<th>`. Requires `sort_field`/
                                  `current_url` to be passed too.
          sort_key?:     string   canonical `?sort=` key when it differs
                                  from `path` (rare).
          cell_partial?: string   template path; when set, the cell is
                                   rendered by including this partial with
                                   {state: <resolved path value>, item: <row item>}
                                   instead of printing the raw value as text.
      }>
      @var empty_message     string
      @var entity_label      string       e.g. 'User', 'Role'
      @var show_actions      bool         default true
      @var new_permission    ?string      permission required to see the "New" button, or null
      @var view_path         ?string      per-row view route name
      @var view_permission   ?string
      @var edit_path         ?string      per-row edit route name
      @var edit_permission   ?string
      @var delete_path       ?string      per-row delete route name
      @var delete_tokens     array<int,string>  entity_id => token
      @var delete_permission ?string
      @var impersonate_path       ?string           per-row impersonate route name
      @var impersonate_tokens     array<int,string> entity_id => token
      @var impersonate_permission ?string
      @var resend_path            ?string           per-row resend route name
      @var resend_tokens          array<int,string> entity_id => token
      @var resend_permission      ?string

      Sortable headers (opt-in): pass `sort_field` (may be null) and
      `current_url` so any column with `sortable: true` renders through
      `_list_header.html.twig`. Columns without `sortable: true` always
      render as a plain `<th>`, even when the list overall has sorting
      enabled — a controller marks only the columns that are actually
      sortable.

      Filtered-empty state (opt-in): when `has_any_filter` is true AND
      `items` is empty, the empty state shows a "no results match your
      filters" message with a "Clear filters" link (using `current_url`
      with all query params stripped) instead of the "create the first
      one" copy.

      Bulk-selection column (opt-in): when `with_bulk_checkbox` is true,
      the table renders a leading checkbox column. `assets/js/crud-bulk-
      actions.js` wires the checkboxes to the bulk-actions disclosure
      rendered by `_list_toolbar.html.twig` (select-all, per-row count,
      modal dispatch).
#}

{% if items|length == 0 %}
    {% if has_any_filter|default(false) %}
        <div class="rounded-lg border border-dashed border-stone-300 bg-stone-50 p-12 text-center">
            <p class="text-stone-600">{{ 'app.administration.crud.empty_with_filters'|trans }}</p>
            {% if current_url is defined and current_url %}
                <a href="{{ current_url|split('?')|first }}"
                   class="mt-4 inline-flex items-center gap-1.5 rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700 shadow-sm hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-400 focus:ring-offset-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="h-4 w-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                    {{ 'app.administration.crud.filters.clear'|trans }}
                </a>
            {% endif %}
        </div>
    {% else %}
        {% include 'shared/crud/_empty_state.html.twig' with {
            message: empty_message|default('app.administration.crud.empty'|trans({'%entity%': entity_label|default('item')|lower})),
            action_path: new_path|default(null),
            action_label: new_label|default('app.administration.crud.create'|trans),
            action_permission: new_permission|default(null)
        } %}
    {% endif %}
{% else %}
    <div class="overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-stone-200">
            <thead class="bg-stone-50">
                <tr>
                    {% if with_bulk_checkbox|default(false) %}
                        <th scope="col" class="w-10 px-4 py-3">
                            <label class="sr-only" for="crud-bulk-select-all">{{ 'app.administration.crud.bulk.select_all_aria'|trans }}</label>
                            <input type="checkbox" id="crud-bulk-select-all" data-crud-bulk-select-all
                                   class="h-4 w-4 rounded border-stone-300 text-amber-700 focus:ring-amber-600">
                        </th>
                    {% endif %}
                    {% for col in columns %}
                        {% if col.sortable|default(false) and sort_field is defined %}
                            {% include 'shared/crud/_list_header.html.twig' with {
                                column: col,
                                sort_field: sort_field,
                                sort_dir: sort_dir|default(null),
                                current_url: current_url|default(app.request.uri),
                            } only %}
                        {% else %}
                            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-stone-500">{{ col.label }}</th>
                        {% endif %}
                    {% endfor %}
                    {% if show_actions ?? true %}
                        <th scope="col" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-stone-500">{{ 'app.administration.crud.actions_label'|trans }}</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody class="divide-y divide-stone-200 bg-white">
                {% for item in items %}
                    <tr class="hover:bg-stone-50">
                        {% if with_bulk_checkbox|default(false) %}
                            <td class="w-10 px-4 py-3">
                                <label class="sr-only" for="crud-bulk-row-{{ item.id }}">{{ 'app.administration.crud.bulk.select_row_aria'|trans }}</label>
                                <input type="checkbox" id="crud-bulk-row-{{ item.id }}" data-crud-bulk-row value="{{ item.id }}"
                                       class="h-4 w-4 rounded border-stone-300 text-amber-700 focus:ring-amber-600">
                            </td>
                        {% endif %}
                        {% for col in columns %}
                            <td class="px-4 py-3 text-sm text-stone-800 {{ col.class|default('') }}">
                                {% set value = item %}
                                {% for segment in col.path|split('.') %}
                                    {% if value is null %}
                                        {% set value = '' %}
                                    {% else %}
                                        {% set value = attribute(value, segment, [], '') %}
                                    {% endif %}
                                {% endfor %}
                                {% if col.cell_partial is defined and col.cell_partial %}
                                    {% include col.cell_partial with {state: value, item: item} only %}
                                {% elseif value is iterable %}
                                    {{ value|length }}
                                {% else %}
                                    {{ value|default('') }}
                                {% endif %}
                            </td>
                        {% endfor %}
                        {% if show_actions ?? true %}
                            <td class="px-4 py-3 text-right text-sm font-medium">
                                {% block crud_list_actions %}
                                    {% include 'shared/crud/_row_actions.html.twig' with {
                                        entity: item,
                                        entity_label: entity_label|default('item'),
                                        view_path: view_path|default(null),
                                        view_permission: view_permission|default(null),
                                        edit_path: edit_path|default(null),
                                        edit_permission: edit_permission|default(null),
                                        delete_path: delete_path|default(null),
                                        delete_token: delete_tokens is defined and delete_tokens[item.id] is defined ? delete_tokens[item.id] : null,
                                        delete_permission: delete_permission|default(null),
                                        impersonate_path: impersonate_path|default(null),
                                        impersonate_token: impersonate_tokens is defined and impersonate_tokens[item.id] is defined ? impersonate_tokens[item.id] : null,
                                        impersonate_permission: impersonate_permission|default(null),
                                        resend_path: resend_path|default(null),
                                        resend_token: resend_tokens is defined and resend_tokens[item.id] is defined ? resend_tokens[item.id] : null,
                                        resend_permission: resend_permission|default(null)
                                    } %}
                                {% endblock %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}

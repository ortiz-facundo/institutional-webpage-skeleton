{#
    Reusable form partial. Renders a card with title, the Symfony form,
    and a submit button. Delete is NOT included here — the row-actions
    partial on the list view is the canonical place to delete entities.

    Contract:
      @var form          Symfony\Component\Form\FormView
      @var title         string
      @var back_path     string
      @var submit_label  string           e.g. 'Save'

    Extension points:
      crud_form_body         — replace the form fields block.
      crud_form_submit_help  — render anything between the form fields
                               and the submit button (default: empty).
                               Use for entity-specific notes that
                               explain the consequence of submitting.
#}
<div class="mb-4">
    <a href="{{ path(back_path) }}" class="text-sm text-stone-500 hover:text-stone-900">&larr; {{ 'app.administration.crud.back'|trans }}</a>
</div>

<div class="rounded-lg border border-stone-200 bg-white p-6 shadow-sm max-w-2xl">
    <h1 class="text-2xl font-serif text-stone-900 mb-6">{{ title }}</h1>

    {{ form_start(form, {attr: {class: 'space-y-2', novalidate: 'novalidate'}}) }}
    {% block crud_form_body %}
        {{ form_widget(form) }}
    {% endblock %}
    {% block crud_form_submit_help %}{% endblock %}
    <div class="mt-6 flex items-center justify-end">
        <button type="submit"
                class="inline-flex items-center rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 shadow-sm hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
            {{ submit_label|default('app.administration.crud.save'|trans) }}
        </button>
    </div>
    {{ form_end(form) }}
</div>

{% extends 'base.html.twig' %}

{% block title %}{{ 'login.page_title'|trans }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-stone-100 px-4">
        <div class="w-full max-w-md">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    {% set color = label == 'error' ? 'rose' : (label == 'success' ? 'emerald' : 'stone') %}
                    <div class="mb-4 rounded-md border border-{{ color }}-200 bg-{{ color }}-50 p-3 text-sm text-{{ color }}-800">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-stone-900 text-stone-50 text-xl mb-4" aria-hidden="true">🛠</div>
                <h1 class="font-serif text-3xl text-stone-900">Skeleton</h1>
                <p class="text-stone-500 mt-1 text-sm">{{ 'login.brand_subtitle'|trans }}</p>
            </div>

            <div class="rounded-lg border border-stone-200 bg-white p-8 shadow-sm">
                {% if error %}
                    <div class="mb-4 rounded-md border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800">
                        {# Symfony intentionally converts DisabledException to a
                           generic "Invalid credentials" to prevent user
                           enumeration — disabled accounts shouldn't reveal
                           their state to anyone trying to log in. #}
                        {{ 'login.invalid'|trans }}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('security_login') }}" class="space-y-4">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div>
                        <label for="email" class="block text-sm font-medium text-stone-700 mb-1">{{ 'login.email'|trans }}</label>
                        <input type="email" name="_email" id="email" value="{{ last_email }}"
                               autocomplete="email" required autofocus
                               class="block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 placeholder-stone-400 shadow-sm focus:border-amber-600 focus:outline-none focus:ring-1 focus:ring-amber-600">
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-medium text-stone-700 mb-1">{{ 'login.password'|trans }}</label>
                        <input type="password" name="_password" id="password"
                               autocomplete="current-password" required
                               class="block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-900 placeholder-stone-400 shadow-sm focus:border-amber-600 focus:outline-none focus:ring-1 focus:ring-amber-600">
                    </div>

                    <button type="submit"
                            class="w-full inline-flex items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 shadow-sm hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                        {{ 'login.submit'|trans }}
                    </button>
                </form>
            </div>

            <p class="mt-6 text-center text-sm text-stone-500">
                {{ 'login.signup_hint'|trans }}
                <br>
                {{ 'login.signup_hint_line2'|trans }}
            </p>
        </div>
    </div>
{% endblock %}

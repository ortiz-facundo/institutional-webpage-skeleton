<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head><meta charset="UTF-8"><title>{{ 'email.disabled.subject'|trans }}</title></head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; max-width: 560px; margin: 0 auto; padding: 24px; color: #1c1917;">
    <p>{{ 'email.disabled.body'|trans({'%name%': user.name ?? user.email}) }}</p>
    {% if reason %}
        <p>{{ 'email.disabled.reason'|trans({'%reason%': reason}) }}</p>
    {% endif %}
</body>
</html>
{% extends 'base.html.twig' %}

{% block title %}Create account — Nova Argentum{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-stone-100 px-4 py-12">
        <div class="w-full max-w-md">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    {% set color = label == 'error' ? 'rose' : (label == 'success' ? 'emerald' : 'stone') %}
                    <div class="mb-4 rounded-md border border-{{ color }}-200 bg-{{ color }}-50 p-3 text-sm text-{{ color }}-800">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-stone-900 text-stone-50 text-xl mb-4" aria-hidden="true">&#129689;</div>
                <h1 class="font-serif text-3xl text-stone-900">Create your account</h1>
                <p class="text-stone-500 mt-1 text-sm">Get access to the Nova Argentum backoffice</p>
            </div>

            <div class="rounded-lg border border-stone-200 bg-white p-8 shadow-sm">
                {{ form_start(form, {attr: {class: 'space-y-2'}}) }}
                    {{ form_widget(form) }}
                    <button type="submit"
                            class="mt-4 w-full inline-flex items-center justify-center rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 shadow-sm hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
                        Create account
                    </button>
                {{ form_end(form) }}
            </div>

            <p class="mt-6 text-center text-sm text-stone-500">
                Already have an account?
                <a href="{{ path('app_login') }}" class="text-amber-700 hover:text-amber-800 font-medium">Sign in</a>
            </p>
        </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Invalid link — Nova Argentum{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-stone-100 px-4">
        <div class="w-full max-w-md">
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-stone-900 text-stone-50 text-xl mb-4" aria-hidden="true">&#129689;</div>
                <h1 class="font-serif text-3xl text-stone-900">Invalid or expired link</h1>
                <p class="text-stone-500 mt-1 text-sm">
                    {% if reason is defined and reason == 'user_no_longer_pending' %}
                        Your account is no longer awaiting activation. An administrator may have disabled it.
                    {% else %}
                        This invitation link is invalid, has expired, or has already been used.
                    {% endif %}
                </p>
            </div>

            <div class="rounded-lg border border-stone-200 bg-white p-8 shadow-sm text-sm text-stone-700">
                <p class="m-0">
                    Please contact the administrator who created your account and ask them to send a new invitation.
                </p>
            </div>
        </div>
    </div>
{% endblock %}
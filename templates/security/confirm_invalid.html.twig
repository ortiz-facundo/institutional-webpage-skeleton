{% extends 'base.html.twig' %}

{% block title %}{{ 'invalid_link.page_title'|trans }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-stone-100 px-4">
        <div class="w-full max-w-md">
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-stone-900 text-stone-50 text-xl mb-4" aria-hidden="true">&#129689;</div>
                <h1 class="font-serif text-3xl text-stone-900">{{ 'invalid_link.heading'|trans }}</h1>
                <p class="text-stone-500 mt-1 text-sm">
                    {% if reason is defined and reason == 'user_no_longer_pending' %}
                        {{ 'app.administration.confirm_invalid.user_no_longer_pending'|trans }}
                    {% else %}
                        {{ 'invalid_link.expired'|trans }}
                    {% endif %}
                </p>
            </div>

            <div class="rounded-lg border border-stone-200 bg-white p-8 shadow-sm text-sm text-stone-700">
                <p class="m-0">
                    {{ 'invalid_link.contact_admin'|trans }}
                </p>
            </div>
        </div>
    </div>
{% endblock %}
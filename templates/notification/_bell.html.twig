<div class="relative" data-notification-bell
     data-feed="{{ path('notification_feed') }}"
     data-read-url="{{ path('notification_read', {id: 0}) }}"
     data-token="{{ csrf_token('notification_inbox') }}"
     data-empty="{{ 'app.notification.empty'|trans }}"
     data-error="{{ 'app.notification.error'|trans }}">
    <button type="button" data-notification-toggle aria-expanded="false" aria-controls="notification-panel"
            aria-label="{{ 'app.notification.title'|trans }}"
            class="relative inline-flex h-10 w-10 items-center justify-center rounded-md text-stone-600 hover:bg-stone-100 focus:ring-2 focus:ring-amber-600">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75v-.7a6 6 0 0 0-12 0v.7a8.967 8.967 0 0 1-2.311 6.022 23.848 23.848 0 0 0 5.454 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/></svg>
        <span data-notification-count class="absolute -right-1 -top-1 hidden rounded-full bg-amber-700 px-1.5 text-xs font-bold text-white"></span>
    </button>
    <section id="notification-panel" data-notification-panel hidden aria-label="{{ 'app.notification.title'|trans }}"
             class="absolute right-0 top-12 z-20 w-80 max-w-[calc(100vw-2rem)] rounded-lg border border-stone-200 bg-white shadow-xl">
        <header class="flex items-center justify-between border-b border-stone-200 px-4 py-3">
            <h2 class="font-serif text-lg">{{ 'app.notification.title'|trans }}</h2>
            <a href="{{ path('notification_list') }}" class="text-sm text-amber-700">{{ 'app.notification.view_all'|trans }}</a>
        </header>
        <div data-notification-items class="max-h-96 overflow-y-auto" aria-live="polite"></div>
    </section>
</div>

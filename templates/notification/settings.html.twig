{% extends 'account/base.html.twig' %}
{% block settings_title %}{{ 'app.notification.settings'|trans }}{% endblock %}
{% block settings_content %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <nav aria-label="{{ 'app.account.index.settings'|trans }}" class="text-sm">
            <a href="{{ path('account_profile_settings') }}"
               class="text-stone-500 hover:text-stone-900">{{ 'app.account.index.settings'|trans }}</a>
            <span aria-hidden="true" class="mx-2 text-stone-400">&rsaquo;</span>
            <span aria-current="page" class="font-medium text-stone-900">{{ 'app.notification.settings'|trans }}</span>
        </nav>
        <div class="shrink-0">
            {% include 'account/_back_link.html.twig' %}
        </div>
    </div>
    <div class="rounded-lg border border-stone-200 bg-white p-5" data-push-settings
         data-key="{{ publicKey }}" data-token="{{ csrf_token('notification_subscription') }}"
         data-register="{{ path('notification_subscribe') }}" data-status="{{ path('notification_subscription_status') }}"
         data-disable="{{ path('notification_unsubscribe', {id: 0}) }}"
         data-unsupported="{{ 'app.notification.unsupported'|trans }}" data-denied="{{ 'app.notification.denied'|trans }}"
         data-error="{{ 'app.notification.error'|trans }}" data-enabled="{{ 'app.notification.enabled'|trans }}"
         data-disabled="{{ 'app.notification.disabled'|trans }}">
        <p class="text-sm text-stone-600">{{ 'app.notification.device_help'|trans }}</p>
        {% if is_impersonating() %}
            <p class="mt-3 text-sm text-amber-700">{{ 'app.notification.impersonating'|trans }}</p>
        {% elseif not publicKey %}
            <p class="mt-3 text-sm text-amber-700">{{ 'app.notification.not_configured'|trans }}</p>
        {% else %}
            <div class="mt-4 flex flex-wrap gap-3">
                <button type="button" data-push-enable disabled class="rounded-md bg-stone-900 px-4 py-2 text-sm text-white disabled:opacity-50">{{ 'app.notification.enable'|trans }}</button>
                <button type="button" data-push-disable disabled class="rounded-md border border-stone-300 px-4 py-2 text-sm text-stone-700 disabled:opacity-50">{{ 'app.notification.disable'|trans }}</button>
            </div>
            <p data-push-message role="status" class="mt-3 text-sm text-stone-600"></p>
        {% endif %}
    </div>
    <h3 class="mb-3 mt-6 font-medium text-stone-900">{{ 'app.notification.devices'|trans }}</h3>
    <div class="divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
        {% for subscription in subscriptions %}
            <div class="flex items-center justify-between gap-4 px-5 py-4"><span class="text-sm text-stone-700">{{ subscription.deviceLabel }}</span>
                {% if not is_impersonating() %}<form method="post" action="{{ path('notification_unsubscribe', {id: subscription.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('notification_subscription') }}"><button class="text-sm text-rose-700">{{ 'app.notification.revoke'|trans }}</button></form>{% endif %}
            </div>
        {% else %}<p class="px-5 py-4 text-sm text-stone-500">{{ 'app.notification.no_devices'|trans }}</p>{% endfor %}
    </div>
{% endblock %}

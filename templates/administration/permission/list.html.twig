{% extends 'backoffice/base.html.twig' %}

{% block admin_title %}{{ 'app.backoffice.nav.permissions'|trans }}{% endblock %}

{% block admin_body %}
    {% include 'shared/crud/_breadcrumbs.html.twig' with {trail: trail} %}
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-serif text-stone-900">{{ title }}</h1>
        <p class="text-sm text-stone-500">{{ 'app.administration.crud.total_items'|trans({'%count%': total}) }}</p>
    </div>

    {% if total == 0 %}
        {% include 'shared/crud/_empty_state.html.twig' with {message: 'app.administration.permission.empty'|trans} %}
    {% else %}
        <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white shadow-sm">
            <table class="min-w-full divide-y divide-stone-200">
                <thead class="bg-stone-50">
                    <tr>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-stone-500">{{ 'app.administration.columns.permission.name'|trans }}</th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-stone-500">{{ 'app.administration.columns.permission.label'|trans }}</th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-stone-500">{{ 'app.administration.columns.permission.description'|trans }}</th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-stone-500">{{ 'app.administration.columns.permission.roles_using_it'|trans }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-stone-200 bg-white">
                    {% for group_label, group_items in groups %}
                        <tr class="bg-stone-100/60">
                            <th scope="rowgroup" colspan="4" class="px-4 py-2 text-left text-[11px] font-semibold uppercase tracking-wider text-stone-600">
                                {{ ('permission_group.' ~ group_label ~ '.label')|trans }}
                            </th>
                        </tr>
                        {% for p in group_items %}
                            <tr class="hover:bg-stone-50">
                                <td class="px-4 py-3 text-sm text-stone-900 font-mono">{{ p.name }}</td>
                                <td class="px-4 py-3 text-sm text-stone-900">{{ ('permission.' ~ p.name ~ '.label')|trans }}</td>
                                <td class="px-4 py-3 text-sm text-stone-500">{{ ('permission.' ~ p.name ~ '.description')|trans }}</td>
                                <td class="px-4 py-3 text-sm text-stone-500">{{ p.getRoles()|length }}</td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

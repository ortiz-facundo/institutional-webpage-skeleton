{% extends 'backoffice/base.html.twig' %}

{% block admin_title %}{{ title }}{% endblock %}

{% block admin_body %}
    {% include 'shared/crud/_breadcrumbs.html.twig' with {trail: trail} %}

    <div class="mb-4 flex items-center justify-between">
        <a href="{{ path(back_path) }}" class="text-sm text-stone-500 hover:text-stone-900">&larr; Back to users</a>
        <a href="{{ path(edit_path, {id: entity.id}) }}"
           class="inline-flex items-center gap-2 rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 shadow-sm hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
            </svg>
            <span>Edit</span>
        </a>
    </div>

    <div class="rounded-lg border border-stone-200 bg-white p-6 shadow-sm max-w-2xl">
        <h1 class="text-2xl font-serif text-stone-900 mb-6">{{ title }}</h1>

        <dl class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-2">
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wider text-stone-500">Email</dt>
                <dd class="mt-1 text-sm text-stone-900">{{ entity.email }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wider text-stone-500">Name</dt>
                <dd class="mt-1 text-sm text-stone-900">{{ entity.name ?? '—' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wider text-stone-500">State</dt>
                <dd class="mt-1">{% include '_state_pill.html.twig' with {state: entity.state} only %}</dd>
            </div>
            <div class="sm:col-span-2">
                <dt class="text-xs font-semibold uppercase tracking-wider text-stone-500">Roles</dt>
                <dd class="mt-1 flex flex-wrap gap-1">
                    {% for role in entity.getRoleEntities() %}
                        <span class="inline-flex items-center rounded-full bg-stone-100 px-2 py-0.5 text-xs font-mono text-stone-700">{{ role.name }}</span>
                    {% else %}
                        <span class="text-sm text-stone-400">none</span>
                    {% endfor %}
                </dd>
            </div>
            <div class="sm:col-span-2">
                <dt class="text-xs font-semibold uppercase tracking-wider text-stone-500">Effective permissions</dt>
                <dd class="mt-1 flex flex-wrap gap-1">
                    {% set seen = [] %}
                    {% for role in entity.getRoleEntities() %}
                        {% for perm in role.getPermissions() %}
                            {% if perm.name not in seen %}
                                {% set seen = seen|merge([perm.name]) %}
                                <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-mono text-amber-800">{{ perm.name }}</span>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <span class="text-sm text-stone-400">none</span>
                    {% endfor %}
                </dd>
            </div>
        </dl>
    </div>
{% endblock %}

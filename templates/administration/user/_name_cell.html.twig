{#
    Name column cell for the admin user list: avatar + name as a single
    chip (falls back to email when no name is set), mirroring the
    assigned-seller pattern from the leads list in the gestion-nova
    product line.

    Contract:
      @var item  App\Entity\Administration\User  the row's user
#}
<div class="flex min-w-0 items-center gap-2">
    {% include '_avatar.html.twig' with {user: item, size: 'xs'} only %}
    <div class="min-w-0 truncate font-medium text-stone-800">{{ item.name ?: item.email }}</div>
</div>

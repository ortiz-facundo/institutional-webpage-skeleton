{% extends 'backoffice/base.html.twig' %}

{% block admin_title %}{{ 'app.backoffice.nav.roles'|trans }}{% endblock %}

{% block admin_body %}
    {% include 'shared/crud/_breadcrumbs.html.twig' with {trail: trail} %}
    {% include 'shared/crud/_list_title.html.twig' with {
        title: title,
        new_path: new_path,
        new_label: new_label,
        new_permission: new_permission,
        items: items
    } %}
    {% include 'shared/crud/_list.html.twig' with {
        title: title,
        items: items,
        columns: columns,
        edit_path: edit_path,
        empty_message: empty_message
    } %}
{% endblock %}

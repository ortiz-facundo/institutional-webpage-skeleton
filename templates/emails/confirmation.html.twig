{# Account confirmation email (HTML). Subject + body strings are
   translated via the `trans()` filter; the user's locale determines
   which messages.<locale>.yaml file is consulted. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <title>{{ 'email.confirmation.subject'|trans }}</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; max-width: 560px; margin: 0 auto; padding: 24px; color: #1c1917; background-color: #fafaf9;">

    <p style="margin: 0 0 16px;">{{ 'email.confirmation.greeting'|trans({'%name%': user.name ?? user.email}) }}</p>

    <p style="margin: 0 0 24px;">{{ 'email.confirmation.intro'|trans }}</p>

    <p style="margin: 0 0 24px;">
        <a href="{{ confirmation_url }}"
           style="display: inline-block; padding: 12px 24px; background-color: #1c1917; color: #fafaf9; text-decoration: none; border-radius: 6px; font-weight: 500;">
            {{ 'email.confirmation.cta'|trans }}
        </a>
    </p>

    <p style="margin: 24px 0; font-size: 14px; color: #57534e;">
        {{ 'email.confirmation.expires'|trans({'%hours%': expires_in_hours}) }}
    </p>

    <hr style="border: none; border-top: 1px solid #e7e5e4; margin: 24px 0;">

    <p style="margin: 0; font-size: 12px; color: #78716c;">
        {{ 'email.confirmation.ignore'|trans }}
    </p>
</body>
</html>
{% extends 'admin/base.html.twig' %}

{% block admin_title %}Users{% endblock %}

{% block admin_body %}
    {% include 'admin/crud/_breadcrumbs.html.twig' with {trail: trail} %}
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-serif text-stone-900">{{ title }}</h1>
        <p class="text-sm text-stone-500">{{ items|length }} total</p>
    </div>

    {% if items|length == 0 %}
        {% include 'admin/crud/_empty_state.html.twig' with {message: 'No users yet.'} %}
    {% else %}
        <div class="overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
            <table class="min-w-full divide-y divide-stone-200">
                <thead class="bg-stone-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-stone-500">#</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-stone-500">Email</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-stone-500">Name</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-stone-500">Roles</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-stone-500">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-stone-200 bg-white">
                    {% for user in items %}
                        <tr class="hover:bg-stone-50">
                            <td class="px-4 py-3 text-sm text-stone-500">{{ user.id }}</td>
                            <td class="px-4 py-3 text-sm text-stone-900 font-medium">{{ user.email }}</td>
                            <td class="px-4 py-3 text-sm text-stone-700">{{ user.name ?? '—' }}</td>
                            <td class="px-4 py-3 text-sm text-stone-500">
                                <div class="flex flex-wrap gap-1">
                                    {% for role in user.getRoleEntities() %}
                                        <span class="inline-flex items-center rounded-full bg-stone-100 px-2 py-0.5 text-xs font-mono text-stone-700">{{ role.name }}</span>
                                    {% else %}
                                        <span class="text-stone-400">none</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="px-4 py-3 text-right text-sm font-medium">
                                <a href="{{ path('admin_user_edit_roles', {id: user.id}) }}" class="text-amber-700 hover:text-amber-800">Edit roles</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{% block admin_title %}Backoffice{% endblock %} — Nova Argentum{% endblock %}

{% block body %}
    {# Impersonation banner: only renders when a SwitchUserToken is active,
       which means an admin is acting on another user's behalf. The banner
       names the original admin and offers an "Exit impersonation" button
       so it's impossible to forget you're impersonating. #}
    {% if is_impersonating() %}
        <div class="border-b-2 border-amber-400 bg-amber-100 px-6 py-2.5 text-sm text-amber-900">
            <div class="mx-auto flex max-w-7xl items-center justify-between">
                <span>
                    <strong>Impersonation active.</strong>
                    You are acting as <strong>{{ app.user.email }}</strong>
                    &mdash; originally <em>{{ impersonator_email() }}</em>.
                </span>
                <form method="post" action="{{ path('admin_user_exit_impersonation') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('exit_impersonation') }}">
                    <button type="submit"
                            class="rounded-md bg-amber-700 px-3 py-1 text-xs font-medium text-amber-50 hover:bg-amber-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2 focus:ring-offset-amber-100">
                        Exit impersonation
                    </button>
                </form>
            </div>
        </div>
    {% endif %}

    <div class="flex min-h-screen bg-stone-50">
        {% include 'admin/_sidebar.html.twig' with {current_route: app.request.attributes.get('_route')} %}
        <main class="flex-1 overflow-y-auto">
            <div class="mx-auto max-w-6xl px-8 py-8">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {% set color = label == 'error' ? 'rose' : (label == 'success' ? 'emerald' : 'stone') %}
                        <div class="mb-4 rounded-md border border-{{ color }}-200 bg-{{ color }}-50 p-3 text-sm text-{{ color }}-800">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block admin_body %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}

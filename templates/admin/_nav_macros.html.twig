        users:     'M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z',
        shield:    'M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.745 3.745 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.745 3.745 0 0 1 3.296-1.043A3.745 3.745 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.745 3.745 0 0 1 3.296 1.043 3.745 3.745 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z',
        key:       'M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z',
    } %}{{- icons[name]|default('') -}}
{% endmacro %}

{% macro nav_item(item, current_route) %}
    {% import _self as self %}
    {% if self.nav_item_is_visible(item) %}
        {% set active = current_route starts with item.route_prefix %}
        <li>
            <a href="{{ path(item.route) }}"
               aria-current="{{ active ? 'page' : 'false' }}"
               class="flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium {{ active ? 'bg-stone-900 text-stone-50' : 'text-stone-700 hover:bg-stone-100' }}">
                <svg xmlns="http://www.w3.org/2000/svg"
                     fill="none" viewBox="0 0 24 24"
                     stroke-width="1.5" stroke="currentColor"
                     aria-hidden="true"
                     class="h-4 w-4 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="{{ self.icon_d(item.icon) }}" />
                </svg>
                <span>{{ item.label }}</span>
            </a>
        </li>
    {% endif %}
{% endmacro %}

{# @var group array { label: string|null, items: list<item> } #}
{% macro nav_group(group, current_route) %}
    {% import _self as self %}
    {% set visible_items = [] %}
    {% for item in group.items %}
        {% if self.nav_item_is_visible(item) %}
            {% set visible_items = visible_items|merge([item]) %}
        {% endif %}
    {% endfor %}
    {% if visible_items|length > 0 %}
        {% if group.label %}
            <div class="mt-2 first:mt-0">
                <h2 class="px-3 pb-2 text-[0.6875rem] font-medium uppercase tracking-wider text-stone-400 border-b border-stone-200">
                    {{ group.label }}
                </h2>
                <ul class="mt-2 space-y-1">
                    {% for item in visible_items %}
                        {{ self.nav_item(item, current_route) }}
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            <ul class="space-y-1">
                {% for item in visible_items %}
                    {{ self.nav_item(item, current_route) }}
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}
{% endmacro %}
